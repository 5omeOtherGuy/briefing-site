#!/usr/bin/env bash
# gate: everything a change must pass. Validates data/*.json, runs the test
# suite (which also rebuilds docs/ and compares it byte for byte) and the
# secret scan. Quiet on success, specific on failure.
# PYTHON selects the interpreter (default: python3).
set -euo pipefail
cd "$(dirname "$0")/.."
py=${PYTHON:-python3}

run() { # label command...: print the command's output only when it fails
  local label=$1 out
  shift
  if ! out=$("$@" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "gate: $label failed" >&2
    exit 1
  fi
  case $out in *skipped=*) printf 'gate: %s: %s\n' "$label" "${out##*$'\n'}" >&2;; esac
}

run "data check" "$py" build.py --check
run "tests" "$py" -m unittest discover -q -s tests
run "secret scan" tools/secret-scan.sh
